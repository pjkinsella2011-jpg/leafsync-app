</section>

</main>


<!-- NAVIGATION -->

<nav>

  <button class="nav active"
    onclick="navigate('dashboard',this)">
    <span>⌂</span>
    Today
  </button>


  <button class="nav"
    onclick="navigate('customers',this)">
    <span>♙</span>
    Customers
  </button>


  <button class="nav"
    onclick="message('No new notifications')">
    <span>◉</span>
    Alerts
  </button>


  <button class="nav"
    onclick="navigate('settings',this)">
    <span>⚙</span>
    Settings
  </button>

</nav>

</div>


<div id="toast"></div>


<script>

let complianceDone = false;
let jobDone = false;


/* CHANGE SCREENS */

function show(id) {

  document.querySelectorAll(".screen")
    .forEach(function(screen) {
      screen.classList.remove("active");
    });

  document.getElementById(id)
    .classList.add("active");

  window.scrollTo(0,0);
}


/* NAVIGATION */

function navigate(id,button) {

  show(id);

  document.querySelectorAll(".nav")
    .forEach(function(nav) {
      nav.classList.remove("active");
    });

  button.classList.add("active");
}


/* OPEN JOB */

function openJob() {
  show("job");
}


/* COMPLIANCE PROGRESS */

const safety =
  document.querySelectorAll(".safety");

safety.forEach(function(box) {

  box.addEventListener("change",function() {

    const checked =
      document.querySelectorAll(
        ".safety:checked"
      ).length;

    const total = safety.length;

    document.getElementById("progressText")
      .textContent =
      checked + " / " + total;

    document.getElementById("bar")
      .style.width =
      ((checked / total) * 100) + "%";

  });

});


/* SAVE COMPLIANCE */

function saveSafety() {

  const checked =
    document.querySelectorAll(
      ".safety:checked"
    ).length;

  if (checked !== safety.length) {

    message("Complete all safety checks first");
    return;

  }

  complianceDone = true;

  message("Compliance check saved");

  setTimeout(function() {
    show("job");
  },600);

}


/* COMPLETE JOB */

function finishJob() {

  const tasks =
    document.querySelectorAll(".task");

  const finished =
    document.querySelectorAll(
      ".task:checked"
    );

  if (finished.length !== tasks.length) {

    message("Tick off all completed work first");
    return;

  }

  if (!complianceDone) {

    message("Complete the compliance check first");
    return;

  }

  jobDone = true;

  document.getElementById("completed")
    .textContent = "1";

  const badge =
    document.getElementById("firstBadge");

  badge.textContent = "COMPLETE";
  badge.className = "badge complete";

  show("invoice");

}


/* SEND INVOICE */

function sendInvoice() {

  if (!jobDone) {

    message("Complete the job first");
    return;

  }

  show("success");

}


/* POPUP MESSAGE */

function message(text) {

  const toast =
    document.getElementById("toast");

  toast.textContent = text;

  toast.classList.add("show");

  setTimeout(function() {

    toast.classList.remove("show");

  },2200);

}

</script>

