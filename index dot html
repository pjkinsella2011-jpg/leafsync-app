    function showScreen(id) {
      document.querySelectorAll(".screen").forEach(function(screen) {
        screen.classList.remove("active");
      });

      document.getElementById(id).classList.add("active");
      window.scrollTo(0, 0);
    }

    function navigate(id, button) {
      showScreen(id);

      document.querySelectorAll(".nav-button").forEach(function(nav) {
        nav.classList.remove("active");
      });

      button.classList.add("active");
    }

    function openJob() {
      showScreen("jobDetails");
    }

    const complianceBoxes = document.querySelectorAll(".complianceCheck");

    complianceBoxes.forEach(function(box) {
      box.addEventListener("change", updateCompliance);
    });

    function updateCompliance() {
      const checked = document.querySelectorAll(".complianceCheck:checked").length;
      const total = complianceBoxes.length;
      const percentage = (checked / total) * 100;

      document.getElementById("progressText").textContent =
        checked + " / " + total;

      document.getElementById("progressBar").style.width =
        percentage + "%";
    }

    function saveCompliance() {
      const checked = document.querySelectorAll(".complianceCheck:checked").length;

      if (checked !== complianceBoxes.length) {
        toast("Complete all safety checks first");
        return;
      }

      complianceComplete = true;
      toast("Compliance check saved");

      setTimeout(function() {
        showScreen("jobDetails");
      }, 600);
    }

    function completeJob() {
      const tasks = document.querySelectorAll(".jobTask");
      const checkedTasks = document.querySelectorAll(".jobTask:checked");

      if (checkedTasks.length !== tasks.length) {
        toast("Tick off all completed work first");
        return;
      }

      if (!complianceComplete) {
        toast("Complete the compliance check first");
        return;
      }

      jobComplete = true;

      document.getElementById("completedCount").textContent = "1";

      const badge = document.getElementById("jobBadge");
      badge.textContent = "COMPLETE";
      badge.className = "badge complete";

      showScreen("invoice");
    }

    function sendInvoice() {
      if (!jobComplete) {
        toast("Complete the job first");
        return;
      }

      showScreen("success");
    }

    function toast(message) {
      const toastBox = document.getElementById("toast");

      toastBox.textContent = message;
      toastBox.classList.add("show");

      setTimeout(function() {
        toastBox.classList.remove("show");
      }, 2200);
    }
  </script>

