    </div>


    <label class="check">
      <input type="checkbox" class="task">
      <span>Mow lawns</span>
    </label>


    <label class="check">
      <input type="checkbox" class="task">
      <span>Strim lawn edges</span>
    </label>


    <label class="check">
      <input type="checkbox" class="task">
      <span>Cut hedges</span>
    </label>


    <label class="check">
