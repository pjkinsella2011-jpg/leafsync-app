<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#173f32">
  <title>LeafSync</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --green: #173f32;
      --green2: #245b49;
      --pale: #eaf2ee;
      --gold: #d5b66b;
      --cream: #f6f5f0;
      --white: #ffffff;
      --text: #202722;
      --muted: #748078;
      --border: #e0e6e2;
      --shadow: 0 7px 25px rgba(0,0,0,.08);
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Arial, sans-serif;
      background: #e1e5e2;
      color: var(--text);
    }

    button, textarea, input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .app {
      max-width: 480px;
      margin: auto;
      background: var(--cream);
      min-height: 100vh;
      padding-bottom: 85px;
    }

    /* HEADER */

    header {
      background: var(--green);
      color: white;
      padding: 25px 21px 28px;
      border-radius: 0 0 28px 28px;
    }

    .top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .logo {
      width: 47px;
      height: 47px;
      background: var(--gold);
      color: var(--green);
      border-radius: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 26px;
    }

    .brand h1 {
      font-size: 25px;
      line-height: 1;
    }

    .tagline {
      color: #ccd9d3;
      font-size: 12px;
      margin-top: 5px;
    }

    .avatar {
      width: 42px;
      height: 42px;
      background: var(--green2);
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      font-weight: 800;
      border: 2px solid rgba(255,255,255,.2);
    }

    .welcome {
      margin-top: 27px;
    }

    .welcome small {
      color: #cbd8d2;
    }

    .welcome h2 {
      font-size: 25px;
      margin-top: 4px;
    }

    /* CONTENT */

    main {
      padding: 20px 17px;
    }

    .screen {
      display: none;
    }

    .screen.active {
      display: block;
    }

    .heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }

    .heading h2 {
      font-size: 20px;
    }

    .heading small {
      color: var(--muted);
    }

    /* STATS */

    .stats {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 9px;
      margin-bottom: 24px;
    }

    .stat {
      background: white;
      padding: 14px 7px;
      border-radius: 17px;
      text-align: center;
      box-shadow: var(--shadow);
    }

    .stat strong {
      display: block;
      color: var(--green);
      font-size: 22px;
    }

    .stat small {
      color: var(--muted);
      font-size: 10px;
    }

    /* JOBS */

    .job {
      background: white;
      padding: 17px;
      border-radius: 20px;
      margin-bottom: 12px;
      box-shadow: var(--shadow);
    }

    .job-top {
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }

    .time {
      color: var(--green);
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 6px;
    }

    .job h3 {
      font-size: 17px;
      margin-bottom: 4px;
    }

    .muted {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }

    .badge {
      height: 25px;
      padding: 0 9px;
      display: flex;
      align-items: center;
      border-radius: 20px;
      font-size: 9px;
      font-weight: 900;
      white-space: nowrap;
    }

    .next {
      background: #fff2d0;
      color: #8c6715;
    }

    .scheduled {
      background: var(--pale);
      color: var(--green);
    }

    .complete {
      background: #def1e4;
      color: #22623a;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 13px;
    }

    .chip {
      background: #f0f2f0;
      border-radius: 20px;
      padding: 6px 9px;
      font-size: 10px;
      color: #5b655e;
    }

    .primary {
      width: 100%;
      border: 0;
      background: var(--green);
      color: white;
      padding: 13px;
      border-radius: 13px;
      font-weight: 800;
      margin-top: 14px;
    }

    .secondary {
      width: 100%;
      border: 1px solid var(--border);
      background: white;
      color: var(--green);
      padding: 13px;
      border-radius: 13px;
      font-weight: 700;
      margin-top: 9px;
    }

    .back {
      border: 0;
      background: transparent;
      color: var(--green);
      font-weight: 700;
      padding: 4px 0;
      margin-bottom: 16px;
    }

    /* DETAIL CARD */

    .card {
      background: white;
      border-radius: 21px;
      padding: 19px;
      box-shadow: var(--shadow);
      margin-bottom: 14px;
    }

    .label {
      color: var(--muted);
      font-size: 9px;
      text-transform: uppercase;
      font-weight: 900;
      letter-spacing: .8px;
      margin-top: 18px;
      margin-bottom: 7px;
    }

    .check {
      display: flex;
      gap: 11px;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
    }

    .check:last-child {
      border-bottom: 0;
    }

    input[type=checkbox] {
      width: 20px;
      height: 20px;
      accent-color: var(--green);
    }

    textarea {
      width: 100%;
      min-height: 95px;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      background: #fafbfa;
      resize: vertical;
    }

    /* COMPLIANCE */

    .progress {
      background: #dce5e0;
      height: 8px;
      border-radius: 20px;
      overflow: hidden;
      margin-bottom: 17px;
    }

    .bar {
      height: 100%;
      background: var(--green);
      width: 0%;
      transition: .25s;
    }

    .compliance {
      background: white;
      padding: 15px;
      border-radius: 16px;
      margin-bottom: 9px;
      display: flex;
      align-items: flex-start;
      gap: 11px;
      box-shadow: 0 4px 14px rgba(0,0,0,.04);
    }

    .compliance strong {
      display: block;
      font-size: 14px;
    }

    .compliance small {
      color: var(--muted);
      display: block;
      margin-top: 3px;
      line-height: 1.4;
    }

    /* INVOICE */

    .invoice {
      background: white;
      border-radius: 21px;
      padding: 20px;
      box-shadow: var(--shadow);
    }

    .invoice-head {
      display: flex;
      justify-content: space-between;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }

    .invoice-row {
      display: flex;
      justify-content: space-between;
      padding: 14px 0;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }

    .total {
      display: flex;
      justify-content: space-between;
      padding-top: 19px;
      color: var(--green);
      font-weight: 900;
      font-size: 20px;
    }

    /* CUSTOMERS */

    .customer {
      background: white;
      padding: 15px;
      border-radius: 17px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 9px;
      box-shadow: 0 4px 14px rgba(0,0,0,.04);
    }

    .customer-icon {
      width: 42px;
      height: 42px;
      background: var(--pale);
      color: var(--green);
      border-radius: 13px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-weight: 900;
    }

    .customer strong {
      display: block;
      font-size: 14px;
    }

    .customer small {
      color: var(--muted);
    }

    /* SETTINGS */

    .settings {
      background: white;
      padding: 3px 16px;
      border-radius: 20px;
      box-shadow: var(--shadow);
    }

    .setting {
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .setting:last-child {
      border-bottom: 0;
    }

    .setting small {
      display: block;
      color: var(--muted);
      margin-top: 3px;
    }

    /* SUCCESS */

    .success {
      text-align: center;
      padding: 45px 12px;
    }

    .tick {
      margin: auto auto 20px;
      width: 75px;
      height: 75px;
      border-radius: 50%;
      background: var(--green);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 35px;
    }

    .success p {
      color: var(--muted);
      margin-top: 8px;
      line-height: 1.5;
    }

    /* NAV */

    nav {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      max-width: 480px;
      width: 100%;
      height: 70px;
      background: rgba(255,255,255,.97);
      border-top: 1px solid var(--border);
      display: grid;
      grid-template-columns: repeat(4,1fr);
      z-index: 50;
    }

    .nav {
      border: 0;
      background: transparent;
      color: #929a95;
      font-size: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
    }

    .nav span {
      font-size: 20px;
    }

    .nav.active {
      color: var(--green);
      font-weight: 800;
    }

    /* TOAST */

    #toast {
      position: fixed;
      bottom: 85px;
      left: 50%;
      transform: translate(-50%,20px);
      background: #202722;
      color: white;
      padding: 11px 15px;
      border-radius: 12px;
      font-size: 12px;
      opacity: 0;
      pointer-events: none;
      transition: .25s;
      z-index: 100;
    }

    #toast.show {
      opacity: 1;
      transform: translate(-50%,0);
    }

    @media(min-width:600px) {
      body {
        padding: 25px 0;
      }

      .app {
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,.14);
      }
    }
  </style>
</head>

<body>

<div class="app">

<header>

  <div class="top">

    <div class="brand">
      <div class="logo">L</div>

      <div>
        <h1>LeafSync</h1>
        <div class="tagline">Landscaping. In sync.</div>
      </div>
    </div>

    <div class="avatar">PK</div>

  </div>

  <div class="welcome">
    <small>Good afternoon</small>
