</section>


<!-- JOB DETAILS -->

<section id="job" class="screen">

  <button class="back"
    onclick="show('dashboard')">
    ← Back to Today's Jobs
  </button>


  <div class="card">

    <div class="time">09:00 – 11:00</div>

    <h2>Manor Farm House</h2>

    <div class="muted">
      Garden maintenance
    </div>


    <div class="label">
